# Frontend (Exposed to client)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend (Server-side only - DO NOT expose)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Payments — PayU
PAYMENT_PROVIDER=payu
PAYU_MODE=test                 # 'test' while testing, 'live' for production
PAYU_KEY=your_payu_merchant_key
PAYU_SALT=your_payu_merchant_salt   # keep secret, server-side only

# Owner panel (Account → Owner panel)
OWNER_EMAIL=
OWNER_USER_ID=
